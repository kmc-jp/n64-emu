#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uFrameA;
layout(set = 0, binding = 1) uniform sampler2D uFrameB;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D uOut;

layout(push_constant) uniform Push {
    uvec2 out_size;
    float phase;
} push;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(push.out_size.x) || p.y >= int(push.out_size.y))
        return;

    vec2 uv = (vec2(p) + 0.5) / vec2(push.out_size);
    float t = clamp(push.phase, 0.0, 1.0);
    vec4 a = textureLod(uFrameA, uv, 0.0);
    vec4 b = textureLod(uFrameB, uv, 0.0);
    imageStore(uOut, p, mix(a, b, t));
}
