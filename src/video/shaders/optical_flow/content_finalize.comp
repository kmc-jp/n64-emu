#version 450
layout(local_size_x = 1, local_size_y = 1) in;

layout(set = 0, binding = 0) buffer DiffBuf {
    uint total_sad_bits;
    uint pixel_count;
    uint content_changed;
} diff;

layout(push_constant) uniform Push {
    float threshold;
} push;

void main() {
    float mean = 0.0;
    if (diff.pixel_count > 0u)
        mean = (float(diff.total_sad_bits) / 65536.0) / float(diff.pixel_count);
    diff.content_changed = mean > push.threshold ? 1u : 0u;
}
