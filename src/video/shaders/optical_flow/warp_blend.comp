#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uFrameA;
layout(set = 0, binding = 1) uniform sampler2D uFrameB;
layout(set = 0, binding = 2) uniform sampler2D uFlowAB; // xy=flow, z=confidence
layout(set = 0, binding = 3) uniform sampler2D uFlowBA;
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D uOut;
layout(set = 0, binding = 5) readonly buffer SceneBuf {
    uint total_sad_bits;
    uint pixel_count;
    uint scene_cut;
} scene;
layout(set = 0, binding = 6) uniform sampler2D uPrevFlowAB; // for static snap hysteresis
layout(set = 0, binding = 7) uniform sampler2D uDepthA; // R16F linear Z, optional
layout(set = 0, binding = 8) uniform sampler2D uDepthB;
layout(set = 0, binding = 9) readonly buffer GlobalMotion {
    float ab_x;
    float ab_y;
    float ba_x;
    float ba_y;
} global_motion;

layout(push_constant) uniform Push {
    uvec2 out_size;
    vec2 flow_scale; // out_pixel / flow_pixel
    float phase;
    float debug;
    float onesided;    // 1 = hard A/B switch (legacy)
    float static_snap; // 1 = snap tiny motion to identity UV
    float obmc;        // 1 = 2x2 raised-cosine OBMC
    float have_prev;   // 1 = uPrevFlowAB valid
    float blend_fallback; // 1 = crossfade when unsure (ghosty), 0 = frame hold
    float have_depth;  // 1 = depth textures valid
    float have_global; // 1 = global_motion buffer valid
    float extrapolate; // 1 = forward-warp frame B only (low-latency mode)
} push;

const float PI = 3.14159265;

float smooth_conf(sampler2D flow, vec2 uv) {
    vec2 texel = 1.0 / vec2(textureSize(flow, 0));
    float s = 0.0;
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx)
            s += textureLod(flow, uv + texel * vec2(float(dx), float(dy)), 0.0).z;
    return s / 9.0;
}

vec2 apply_static_snap(vec2 from_uv, vec2 base_uv, vec2 flow_out_px,
                       float prev_len) {
    if (push.static_snap < 0.5)
        return from_uv;
    float len = length(flow_out_px);
    // Hysteresis: stay snapped longer if previous pair looked static.
    float thr = (push.have_prev > 0.5 && prev_len < 0.12) ? 0.12 : 0.08;
    float snap = 1.0 - smoothstep(thr * 0.65, thr, len);
    return mix(from_uv, base_uv, snap);
}

vec4 fetch_flow(sampler2D flow, ivec2 tex, ivec2 fsize) {
    return texelFetch(flow, clamp(tex, ivec2(0), fsize - 1), 0);
}

// Local depth discontinuity (edge strength in 0..1).
float depth_edge(sampler2D depth, vec2 uv) {
    vec2 texel = 1.0 / vec2(textureSize(depth, 0));
    float z = textureLod(depth, uv, 0.0).x;
    float zx = textureLod(depth, uv + vec2(texel.x, 0.0), 0.0).x;
    float zy = textureLod(depth, uv + vec2(0.0, texel.y), 0.0).x;
    float g = max(abs(z - zx), abs(z - zy));
    // N64 Z is nonlinearly quantized; ~1/512 of the 18-bit range is a weak edge.
    return smoothstep(0.002, 0.02, g);
}

// Bidirectional occlusion from depth disagreement at warped sources.
// Nearer surface (smaller Z) wins; the farther contribution is attenuated.
void depth_occlusion_weights(vec2 from_a, vec2 from_b, inout float wA,
                             inout float wB) {
    if (push.have_depth < 0.5)
        return;
    float za = textureLod(uDepthA, from_a, 0.0).x;
    float zb = textureLod(uDepthB, from_b, 0.0).x;
    float edge = max(depth_edge(uDepthA, from_a), depth_edge(uDepthB, from_b));
    float disagree = smoothstep(0.01, 0.06, abs(za - zb));
    float occl = max(disagree, edge);
    // Kill the farther sample when depths disagree / on a depth edge.
    if (za > zb)
        wA *= 1.0 - occl;
    else
        wB *= 1.0 - occl;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(push.out_size.x) || p.y >= int(push.out_size.y))
        return;

    vec2 uv = (vec2(p) + 0.5) / vec2(push.out_size);
    float t = clamp(push.phase, 0.0, 1.0);

    vec4 a0 = textureLod(uFrameA, uv, 0.0);
    vec4 b0 = textureLod(uFrameB, uv, 0.0);

    if (scene.scene_cut != 0u) {
        imageStore(uOut, p, b0);
        return;
    }

    // Experimental low-latency path: tiny forward nudge of frame B only.
    if (push.extrapolate > 0.5) {
        float dt = max(push.phase, 0.0);
        float conf_ab = smooth_conf(uFlowAB, uv);
        float atten_a = smoothstep(0.12, 0.45, conf_ab);
        vec2 fallback_ab = vec2(0.0);
        if (push.have_global > 0.5)
            fallback_ab = vec2(global_motion.ab_x, global_motion.ab_y);
        vec2 f_ab = mix(fallback_ab,
                        textureLod(uFlowAB, uv, 0.0).xy * push.flow_scale,
                        atten_a);
        float motion = length(f_ab);
        // Skip unreliable / huge vectors — they shimmer field-to-field.
        if (atten_a < 0.35 || motion > 20.0) {
            imageStore(uOut, p, b0);
            return;
        }
        vec2 from_b = uv - (dt * f_ab) / vec2(push.out_size);
        vec4 warped = textureLod(uFrameB, from_b, 0.0);
        float keep = atten_a * 0.55;
        vec4 outc = mix(b0, warped, keep);
        if (push.debug > 0.5)
            outc = vec4(0.5 + f_ab.x * 0.05, 0.5 + f_ab.y * 0.05, keep, 1.0);
        imageStore(uOut, p, outc);
        return;
    }

    float static_diff = dot(abs(a0.rgb - b0.rgb), vec3(0.333));
    if (static_diff < 0.012) {
        imageStore(uOut, p, mix(a0, b0, t));
        return;
    }

    float conf_ab = smooth_conf(uFlowAB, uv);
    float conf_ba = smooth_conf(uFlowBA, uv);
    float motion_gate = smoothstep(0.012, 0.06, static_diff);
    conf_ab *= motion_gate;
    conf_ba *= motion_gate;

    float prev_len = 0.0;
    if (push.have_prev > 0.5)
        prev_len = length(textureLod(uPrevFlowAB, uv, 0.0).xy * push.flow_scale);

    // With depth, trust flow farther into low-confidence regions — occlusion
    // handles ghosts instead of shrinking displacement.
    float atten_lo = push.have_depth > 0.5 ? 0.02 : 0.05;
    float atten_hi = push.have_depth > 0.5 ? 0.20 : 0.35;
    float atten_a = smoothstep(atten_lo, atten_hi, conf_ab);
    float atten_b = smoothstep(atten_lo, atten_hi, conf_ba);

    // Low confidence falls back to global camera/pan motion, not zero
    // (sky/walls share the dominant motion but fail block match).
    vec2 fallback_ab = vec2(0.0);
    vec2 fallback_ba = vec2(0.0);
    if (push.have_global > 0.5) {
        fallback_ab = vec2(global_motion.ab_x, global_motion.ab_y);
        fallback_ba = vec2(global_motion.ba_x, global_motion.ba_y);
    }

    vec4 ca = a0;
    vec4 cb = b0;
    vec2 from_a = uv;
    vec2 from_b = uv;
    vec2 f_ab_dbg = mix(fallback_ab,
                        textureLod(uFlowAB, uv, 0.0).xy * push.flow_scale,
                        atten_a);

    if (push.obmc > 0.5) {
        ivec2 fsize = textureSize(uFlowAB, 0);
        vec2 flow_pos = uv * vec2(fsize) - 0.5;
        ivec2 i0 = ivec2(floor(flow_pos));
        vec2 f = flow_pos - vec2(i0);
        // Separable raised-cosine over the flow texel (half-block overlap).
        float wx0 = 0.5 * (1.0 + cos(PI * clamp(f.x, 0.0, 1.0)));
        float wx1 = 1.0 - wx0;
        float wy0 = 0.5 * (1.0 + cos(PI * clamp(f.y, 0.0, 1.0)));
        float wy1 = 1.0 - wy0;
        float wts[4] = float[](wx0 * wy0, wx1 * wy0, wx0 * wy1, wx1 * wy1);
        ivec2 offs[4] = ivec2[](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));

        vec4 sum_a = vec4(0.0);
        vec4 sum_b = vec4(0.0);
        float wsum = 0.0;
        vec2 sum_from_a = vec2(0.0);
        vec2 sum_from_b = vec2(0.0);
        for (int i = 0; i < 4; ++i) {
            float w = wts[i];
            if (w < 1e-4)
                continue;
            vec4 fab = fetch_flow(uFlowAB, i0 + offs[i], fsize);
            vec4 fba = fetch_flow(uFlowBA, i0 + offs[i], fsize);
            vec2 fab_out = mix(fallback_ab, fab.xy * push.flow_scale, atten_a);
            vec2 fba_out = mix(fallback_ba, fba.xy * push.flow_scale, atten_b);
            vec2 fa = uv - (t * fab_out) / vec2(push.out_size);
            vec2 fb = uv + ((1.0 - t) * fba_out) / vec2(push.out_size);
            fa = apply_static_snap(fa, uv, fab_out, prev_len);
            fb = apply_static_snap(fb, uv, fba_out, prev_len);
            sum_a += w * textureLod(uFrameA, fa, 0.0);
            sum_b += w * textureLod(uFrameB, fb, 0.0);
            sum_from_a += w * fa;
            sum_from_b += w * fb;
            wsum += w;
        }
        ca = sum_a / max(wsum, 1e-4);
        cb = sum_b / max(wsum, 1e-4);
        from_a = sum_from_a / max(wsum, 1e-4);
        from_b = sum_from_b / max(wsum, 1e-4);
    } else {
        vec4 fab4 = textureLod(uFlowAB, uv, 0.0);
        vec4 fba4 = textureLod(uFlowBA, uv, 0.0);
        vec2 f_ab = mix(fallback_ab, fab4.xy * push.flow_scale, atten_a);
        vec2 f_ba = mix(fallback_ba, fba4.xy * push.flow_scale, atten_b);
        f_ab_dbg = f_ab;
        from_a = uv - (t * f_ab) / vec2(push.out_size);
        from_b = uv + ((1.0 - t) * f_ba) / vec2(push.out_size);
        from_a = apply_static_snap(from_a, uv, f_ab, prev_len);
        from_b = apply_static_snap(from_b, uv, f_ba, prev_len);
        ca = textureLod(uFrameA, from_a, 0.0);
        cb = textureLod(uFrameB, from_b, 0.0);
    }

    // Crossfading two frames is what produces double images, so unsure pixels
    // hold the temporally nearest frame instead (judder beats ghosting).
    vec4 fallback = push.blend_fallback > 0.5 ? mix(a0, b0, t)
                                              : (t <= 0.5 ? a0 : b0);
    vec4 outc = fallback;

    float diff = dot(abs(ca.rgb - cb.rgb), vec3(0.333));
    // Color agreement is a weak occlusion proxy; with real depth, relax it.
    float agree_lo = push.have_depth > 0.5 ? 0.08 : 0.04;
    float agree_hi = push.have_depth > 0.5 ? 0.35 : 0.22;
    float agree = 1.0 - smoothstep(agree_lo, agree_hi, diff);

    if (push.onesided > 0.5) {
        // Legacy hard source pick (for A/B bisect via N64_FLOW_ONESIDED=1).
        const float conf_hi = 0.25;
        bool ok_a = conf_ab >= conf_hi;
        bool ok_b = conf_ba >= conf_hi;
        if (ok_a && ok_b) {
            outc = mix(fallback, mix(ca, cb, t), agree * min(conf_ab, conf_ba));
        } else if (ok_a) {
            outc = mix(fallback, ca, conf_ab);
        } else if (ok_b) {
            outc = mix(fallback, cb, conf_ba);
        }
    } else {
        float wA = max(conf_ab * (1.0 - t), 0.0);
        float wB = max(conf_ba * t, 0.0);
        depth_occlusion_weights(from_a, from_b, wA, wB);

        // Without depth, sharpen toward the better side when warps disagree.
        // With depth, keep blending softer — occlusion already killed ghosts.
        float sharp = push.have_depth > 0.5 ? mix(2.0, 1.0, agree)
                                            : mix(8.0, 1.0, agree);
        wA = pow(max(wA, 0.0), sharp);
        wB = pow(max(wB, 0.0), sharp);
        float wsum = wA + wB;
        if (wsum > 1e-6) {
            vec4 warped = (wA * ca + wB * cb) / wsum;
            float conf = agree * clamp(max(conf_ab, conf_ba), 0.0, 1.0);
            if (push.have_depth > 0.5)
                conf = max(conf, clamp(max(conf_ab, conf_ba), 0.0, 1.0) * 0.85);
            outc = mix(fallback, warped, conf);
        }
    }

    if (push.debug > 0.5) {
        if (push.have_depth > 0.5) {
            float za = textureLod(uDepthA, from_a, 0.0).x;
            float zb = textureLod(uDepthB, from_b, 0.0).x;
            outc = vec4(za, zb, abs(za - zb) * 8.0, 1.0);
        } else {
            outc = vec4(0.5 + f_ab_dbg.x * 0.05, 0.5 + f_ab_dbg.y * 0.05,
                        max(conf_ab, conf_ba), 1.0);
        }
    }

    imageStore(uOut, p, outc);
}
