#version 450
layout(local_size_x = 8, local_size_y = 8) in;

// Scale flow.xy by a constant (k-normalization / restore). Confidence untouched.
layout(set = 0, binding = 0, rgba16f) uniform image2D uFlow;

layout(push_constant) uniform Push {
    uvec2 size;
    float scale;
} push;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(push.size.x) || p.y >= int(push.size.y))
        return;
    vec4 f = imageLoad(uFlow, p);
    imageStore(uFlow, p, vec4(f.xy * push.scale, f.z, f.w));
}
