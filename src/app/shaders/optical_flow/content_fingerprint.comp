#version 450
layout(local_size_x = 8, local_size_y = 8) in;

// Mild dedither + downsample to a tiny fingerprint for novel-frame detection.
layout(set = 0, binding = 0) uniform sampler2D uSrc;
layout(set = 0, binding = 1, r16f) uniform writeonly image2D uDst;

layout(push_constant) uniform Push {
    uvec2 dst_size;
} push;

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    if (dst.x >= int(push.dst_size.x) || dst.y >= int(push.dst_size.y))
        return;

    vec2 texel = 1.0 / vec2(textureSize(uSrc, 0));
    vec2 uv = (vec2(dst) + 0.5) / vec2(push.dst_size);

    // 5x5 box: stronger than the pyramid luma pass; fingerprint must ignore
    // RGBA5551 ordered dither so single-buffer rewrites still match holds.
    vec3 rgb = vec3(0.0);
    for (int dy = -2; dy <= 2; ++dy)
        for (int dx = -2; dx <= 2; ++dx)
            rgb += textureLod(uSrc, uv + texel * vec2(float(dx), float(dy)), 0.0).rgb;
    rgb *= (1.0 / 25.0);
    float luma = dot(rgb, vec3(0.299, 0.587, 0.114));
    imageStore(uDst, dst, vec4(luma, 0.0, 0.0, 0.0));
}
