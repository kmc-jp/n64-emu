#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uSrc;
layout(set = 0, binding = 1, r16f) uniform writeonly image2D uDst;

layout(push_constant) uniform Push {
    uvec2 dst_size;
} push;

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    if (dst.x >= int(push.dst_size.x) || dst.y >= int(push.dst_size.y))
        return;

    vec2 texel = 1.0 / vec2(textureSize(uSrc, 0));
    vec2 uv = (vec2(dst) + 0.5) / vec2(push.dst_size);

    // 2x2 box in source space for mild antialias while downsampling.
    vec3 c0 = textureLod(uSrc, uv + texel * vec2(-0.25, -0.25), 0.0).rgb;
    vec3 c1 = textureLod(uSrc, uv + texel * vec2( 0.25, -0.25), 0.0).rgb;
    vec3 c2 = textureLod(uSrc, uv + texel * vec2(-0.25,  0.25), 0.0).rgb;
    vec3 c3 = textureLod(uSrc, uv + texel * vec2( 0.25,  0.25), 0.0).rgb;
    vec3 rgb = 0.25 * (c0 + c1 + c2 + c3);
    float luma = dot(rgb, vec3(0.299, 0.587, 0.114));
    imageStore(uDst, dst, vec4(luma, 0.0, 0.0, 0.0));
}
